NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use a Supabase secret key for server-only document processing. Never prefix
# this with NEXT_PUBLIC_ or commit the real value.
SUPABASE_SECRET_KEY=
# Used only on the server to create document embeddings and study materials.
# Never prefix this with NEXT_PUBLIC_ or commit the real value.
OPENAI_API_KEY=
# Optional local-only substitute for paid embeddings. Never set this in a
# deployment; it produces simulated vectors for development testing only.
# AI_EMBEDDINGS_MODE=mock
# Assessment generation defaults to deterministic mock mode in local
# development. Set this only when enabling paid OpenAI generation later.
# AI_ASSESSMENT_MODE=openai
# OPENAI_ASSESSMENT_MODEL=gpt-5.6

# Tutor generation defaults to deterministic mock mode during local development.
# Use the real provider only after adding OpenAI API credits:
# AI_TUTOR_MODE=openai
# OPENAI_TUTOR_MODEL=gpt-5.6
